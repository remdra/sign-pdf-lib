{
  "name": "sign-pdf-lib",
  "version": "2.0.4",
  "description": "Signs PDF files or just add a placeholder for signature.",
  "files": [
    "_dist/src/**",
    "!_dist/src/**/*.spec.*"
  ],
  "main": "_dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "browserify": "browserify _dist/src/index.js --standalone SignPdfLib -o _dist/sign-pdf-lib.js",
    "test": "ts-mocha --type-check '**/*.spec.ts'",
    "test:dev": "ts-mocha --type-check -watch --watch-files='**/*.ts' '**/*.spec.ts'",
    "prepublishOnly": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remdra/sign-pdf-lib.git"
  },
  "author": "Remus DRAICA (remus.draica@gmail.com)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/remdra/sign-pdf-lib/issues"
  },
  "keywords": [
    "pdf",
    "signing",
    "signature",
    "placeholder"
  ],
  "homepage": "https://github.com/remdra/sign-pdf-lib#readme",
  "dependencies": {
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "browserify": "^17.0.1",
    "lodash": "^4.17.21",
    "node-forge": "^1.3.1",
    "pdf-lib": "npm:pdf-lib-incremental-save@^1.17.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/node-forge": "^1.3.14",
    "@types/pdfmake": "^0.2.12",
    "@types/stream-buffers": "^3.0.8",
    "buffer-replace": "^2.0.0",
    "chai": "^6.2.1",
    "chai-as-promised": "^8.0.2",
    "fs-extra": "^11.3.2",
    "pdfmake": "^0.2.20",
    "stream-buffers": "^3.0.3",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.9.3"
  }
}
